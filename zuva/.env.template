# Configuration for the Zuva stack. Copy to .env and fill in the secrets:
#   cp zuva/.env.template .env
#
# Every variable below is read by code in this repository (sunsynk/,
# zuva/collector/ or zuva_api/). Anything the services do not read has been
# removed - if a setting is not here, adding it changes nothing.
# Defaults shown in [brackets] are what the code uses when the variable is
# unset, so only override what you need.

# --- Required ---------------------------------------------------------------
# Sunsynk portal login (the collector pauses for 6h if these are rejected).
SUNSYNK_USERNAME=your_sunsynk_email@example.com
SUNSYNK_PASSWORD=your_sunsynk_password

# Shared secret between the collector and the API. The API refuses to start
# without it and rejects alerts that do not carry it as X-API-Key.
# Generate one with: openssl rand -hex 32
ZUVA_API_KEY=

# --- Notifications ----------------------------------------------------------
# From @BotFather. Without a token the API starts but delivers nothing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Owner of the default settings row, and the user alerts are filed under.
DEFAULT_USER_ID=robasta

# --- Timezone ---------------------------------------------------------------
# Containers are UTC by default, which shifts quiet hours and the evening
# consumption window. Both variables should match. [Africa/Johannesburg]
TIMEZONE=Africa/Johannesburg

# --- Collector --------------------------------------------------------------
POLL_INTERVAL=600                     # seconds between polls [60]
BATTERY_LOW_THRESHOLD=20              # % SoC [20]
BATTERY_CRITICAL_THRESHOLD=15         # % SoC [10]
HIGH_CONSUMPTION_THRESHOLD_W=400      # watts, daytime [400]
EVENING_CONSUMPTION_THRESHOLD_W=900   # watts, evening [900]
GRID_OUTAGE_CONSECUTIVE_READINGS=3    # readings before declaring an outage [3]
GRID_VOLTAGE_THRESHOLD=50.0           # volts below which the grid is off [50.0]
GRID_OUTAGE_COOLDOWN_MINUTES=30       # minutes between outage reminders, 0 = one alert only [30]
LOGIN_RETRY_WAIT_SECONDS=900          # wait after a connectivity failure [900]
AUTH_FAILURE_BACKOFF_SECONDS=21600    # wait after rejected credentials [21600]

# --- History ----------------------------------------------------------------
# Sent alerts and poll readings are kept in the API's SQLite file and swept by
# the API itself; there is no external database to age them out.
HISTORY_RETENTION_DAYS=90             # 0 keeps everything forever [90]

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=WARN                        # collector [WARN]
UVICORN_LOG_LEVEL=warning             # API access/error log [warning]

# --- Optional -------------------------------------------------------------
# Only needed if a browser calls the API directly; comma-separated origins.
# CORS_ORIGINS=http://localhost:3000
# Image tag the production compose file pulls. [latest]
# ZUVA_VERSION=latest
# Sunsynk HTTP tuning, read by sunsynk/client.py.
# SUNSYNK_REQUEST_TIMEOUT_SECONDS=30
# SUNSYNK_CONNECT_TIMEOUT_SECONDS=10
# SUNSYNK_MAX_RETRIES=3
# SUNSYNK_RETRY_BASE_DELAY_SECONDS=1
# SUNSYNK_LOGIN_RATE_LIMIT_SECONDS=60
# Never set this outside a lab; it disables certificate verification.
# SUNSYNK_VERIFY_TLS=true
# Where the collector keeps alert-suppression state and its liveness marker.
# COLLECTOR_STATE_PATH=/data/collector-state.json
# HEARTBEAT_PATH=/tmp/zuva-heartbeat
# SQLite file holding settings, alert history and readings.
# SETTINGS_DB_PATH=/data/zuva.db
